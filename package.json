{
  "name": "provia",
  "private": true,
  "type": "module",
  "workspaces": [
    "circuits",
    "contracts",
    "agent"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "circuits:build": "npm run build --workspace @provia/circuits",
    "circuits:test": "npm test --workspace @provia/circuits",
    "contracts:test": "npm test --workspace @provia/contracts",
    "agent:test": "npm test --workspace @provia/agent",
    "verify": "npm run agent:typecheck && npm run circuits:test && npm run contracts:test && npm run agent:test",
    "agent:typecheck": "npm run typecheck --workspace @provia/agent"
  }
}
